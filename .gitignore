# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Build and packaged output
build/
dist/
*.exe
*.dll
*.pyd
*.pkg
# 例外：当前成品 dist/AfterIncRevivalTrainer_CN.exe 已用 git add -f 纳入版本控制，换版时同样强制添加

# Local analysis environments and generated scan data
.analysis_deps/
scans/
il2cpp_dump/
tools/Il2CppDumper-*/
tools/Il2CppDumper-*.zip
*.bin

# Native build intermediates (rebuild with native/build*.cmd)
native/*.obj
native/*.lib
native/*.exp
native/*.bak*

# Local backups, logs, and editor state
backups/
*.log
.idea/
.vscode/
Thumbs.db
.DS_Store
